model User {
  id               String              @id @default(uuid())
  email            String              @unique @db.VarChar(254)
  first_name       String              @db.VarChar(100)
  last_name        String              @db.VarChar(100)
  is_admin         Boolean             @default(false)
  is_deleted       Boolean             @default(false)
  created_at       DateTime            @default(now()) @db.Timestamptz(6)
  user_sessions    Session[]
  user_accounts    UserAccount[]
  oauth_identities UserOAuthIdentity[]

  @@map("users")
}

model OAuthProvider {
  id               Int                 @id @default(autoincrement())
  name             String              @unique @db.VarChar(64)
  oauth_identities UserOAuthIdentity[]

  @@map("oauth_providers")
}

model UserOAuthIdentity {
  id          String        @id @default(uuid())
  user_id     String
  profile_id  String        @db.VarChar(255)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  provider_id Int
  provider    OAuthProvider @relation(fields: [provider_id], references: [id], onDelete: NoAction)
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider_id, profile_id])
  @@map("user_oauth_identities")
}

model AuthScheme {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(64)
  services Service[]

  @@map("auth_schemes")
}

model Service {
  id             Int           @id @default(autoincrement())
  name           String        @unique @db.VarChar(64)
  auth_scheme_id Int
  auth_scheme    AuthScheme    @relation(fields: [auth_scheme_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_accounts  UserAccount[]

  @@map("services")
}

model UserAccount {
  user_id    String
  service_id Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  is_active  Boolean  @default(true)
  service    Service  @relation(fields: [service_id], references: [id], onDelete: NoAction)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, service_id])
  @@map("user_accounts")
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  oauth_sid  String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sessions")
}
