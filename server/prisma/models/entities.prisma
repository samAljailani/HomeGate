model User {
  id              String              @id @default(uuid()) @db.Uuid
  email           String              @unique @db.VarChar(254)
  firstName       String              @map("first_name") @db.VarChar(100)
  lastName        String              @map("last_name") @db.VarChar(100)
  isAdmin         Boolean             @default(false) @map("is_admin")
  status          UserStatus          @default(ACTIVE) @map("status")
  provisionedAt   DateTime?           @map("provisioned_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  username        String              @unique @db.VarChar(64)
  avatarUrl       String?             @map("avatar_url") @db.VarChar(512)
  userSessions    Session[]           @relation("UserSessions")
  subscriptions   Subscription[]      @relation("UserSubscriptions")
  externalAccounts ExternalUserAccount[] @relation("UserExternalAccounts")
  oauthIdentities UserOAuthIdentity[] @relation("UserOAuthIdentities")
  logs            Log[]               @relation("UserLogs")
  createdInvites  Invite[]            @relation("CreatedInvites")
  usedInvite      Invite?             @relation("UsedInvites")
  revokedInvites  Invite[]            @relation("RevokedInvites")
  servicePolicies UserServicePolicy[] @relation("UserServicePolicies")
  createdPolicies UserServicePolicy[] @relation("CreatedPolicies")

  @@map("users")
}

model OAuthProvider {
  id              Int                 @id @default(autoincrement())
  name            OAuthProviderName   @unique
  enabled         Boolean             @default(false)
  oauthIdentities UserOAuthIdentity[] @relation("ProviderIdentities")
  sessions        Session[]           @relation("ProviderSessions")

  @@map("oauth_providers")
}

model UserOAuthIdentity {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  profileId  String        @map("profile_id") @db.VarChar(255)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  providerId Int           @map("provider_id")
  provider   OAuthProvider @relation("ProviderIdentities", fields: [providerId], references: [id], onDelete: NoAction)
  user       User          @relation("UserOAuthIdentities", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, profileId], map: "user_oauth_identities_provider_id_profile_id_key")
  @@unique([userId, providerId], map: "user_oauth_identities_user_id_provider_id_key")
  @@map("user_oauth_identities")
}

model AuthScheme {
  id       Int            @id @default(autoincrement())
  name     AuthSchemeName @unique

  @@map("auth_schemes")
}

model Service {
  id                     Int                  @id @default(autoincrement())
  name                   String               @unique @db.VarChar(64)
  slug                   String               @unique @db.VarChar(64)
  enabled                Boolean
  url                    String?              @db.VarChar(512)
  imageUrl               String?              @map("image_url") @db.VarChar(512)

  accountType            AccountType          @map("account_type")
  integrationProvider    IntegrationProvider? @map("integration_provider")
  accountSourceServiceId Int?                 @map("account_source_service_id")
  defaultAllowed         Boolean              @default(true) @map("default_allowed")

  accountSource          Service?             @relation("ServiceAccountSource", fields: [accountSourceServiceId], references: [id], onDelete: NoAction)
  referencingServices    Service[]            @relation("ServiceAccountSource")

  subscriptions          Subscription[]        @relation("ServiceSubscriptions")
  externalAccounts       ExternalUserAccount[] @relation("ServiceExternalAccounts")
  inviteSubscriptions    InviteSubscription[]  @relation("InviteServiceSubscriptions")
  policies               UserServicePolicy[]   @relation("ServicePolicies")

  // One service instance per vendor; see docs/plan.md accepted limitation.
  @@unique([integrationProvider])
  @@map("services")
}

model Subscription {
  id                        String             @id @default(uuid()) @db.Uuid
  userId                    String             @map("user_id") @db.Uuid
  serviceId                 Int                @map("service_id")

  status                    SubscriptionStatus @default(provisioning)

  expiresAt                 DateTime?          @map("expires_at") @db.Timestamptz(6)
  autoRenew                 Boolean            @default(false) @map("auto_renew")

  derivedFromSubscriptionId String?            @map("derived_from_subscription_id") @db.Uuid

  provisionedAt             DateTime?          @map("provisioned_at") @db.Timestamptz(6)
  failedAt                  DateTime?          @map("failed_at") @db.Timestamptz(6)
  cancelledAt               DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  failedOperation           FailedOperation?   @map("failed_operation")
  lastError                 String?            @map("last_error") @db.Text
  retryCount                Int                @default(0) @map("retry_count")

  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                 @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  service              Service              @relation("ServiceSubscriptions", fields: [serviceId], references: [id], onDelete: NoAction)
  derivedFrom          Subscription?        @relation("DerivedSubscriptions", fields: [derivedFromSubscriptionId], references: [id], onDelete: Cascade)
  derivedSubscriptions Subscription[]       @relation("DerivedSubscriptions")
  externalAccount      ExternalUserAccount? @relation("SubscriptionExternalAccount")

  @@unique([userId, serviceId])
  @@index([derivedFromSubscriptionId])
  @@map("subscriptions")
}

model ExternalUserAccount {
  id                String   @id @default(uuid()) @db.Uuid
  subscriptionId    String   @unique @map("subscription_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  serviceId         Int      @map("service_id")
  externalAccountId String?  @map("external_account_id")
  username          String?  @db.VarChar(64)
  email             String?  @db.VarChar(254)

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation("SubscriptionExternalAccount", fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation("UserExternalAccounts", fields: [userId], references: [id], onDelete: Cascade)
  service      Service      @relation("ServiceExternalAccounts", fields: [serviceId], references: [id], onDelete: NoAction)

  @@unique([serviceId, username])
  @@unique([serviceId, externalAccountId])
  @@map("external_user_accounts")
}

model Session {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  authProviderId Int?          @map("auth_provider_id")
  sid            String        @unique
  data           Json
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  device         String?       @db.VarChar(64)
  browser        String?       @db.VarChar(64)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User?         @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  authProvider   OAuthProvider? @relation("ProviderSessions", fields: [authProviderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  logs           Log[]         @relation("SessionLogs")

  @@map("sessions")
}

model Log {
  id            Int       @id @default(autoincrement())
  userId        String?   @map("user_id") @db.Uuid
  sessionId     String?   @map("session_id") @db.Uuid
  correlationId String?   @map("correlation_id")
  logLevel      LogLevel  @map("log_level")
  context       String?   @db.Text
  message       String    @db.Text
  stackTrace    String?   @map("stack_trace")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6) @default(now())
  user          User?     @relation("UserLogs", fields: [userId], references: [id], onDelete: SetNull)
  session       Session?  @relation("SessionLogs", fields: [sessionId], references: [id], onDelete: NoAction)

  @@index([createdAt])
  @@index([logLevel])
  @@index([userId])
  @@index([sessionId])
  @@index([correlationId])

  @@map("logs")
}

model Invite {
  id              String    @id @default(uuid()) @db.Uuid
  token           String    @unique @db.Char(64)
  email           String?   @db.VarChar(254)
  isAdmin         Boolean   @default(false) @map("is_admin")

  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason   InviteRevokedReason? @map("revoked_reason")
  failedAttempts  Int       @default(0) @map("failed_attempts")

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  usedByUserId    String?   @map("used_by_user_id") @db.Uuid
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  createdBy       User?     @relation("CreatedInvites", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  usedBy          User?     @relation("UsedInvites", fields: [usedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  revokedBy       User?     @relation("RevokedInvites", fields: [revokedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  accounts        InviteSubscription[] @relation("InviteSubscriptions")

  @@unique([usedByUserId])
  @@map("invites")
}

model InviteSubscription {
  id        String  @id @default(uuid()) @db.Uuid
  inviteId  String  @map("invite_id") @db.Uuid
  serviceId Int     @map("service_id")
  username  String? @db.VarChar(64)
  email     String? @db.VarChar(254)
  accountId String? @map("account_id") @db.VarChar(255)

  invite  Invite  @relation("InviteSubscriptions", fields: [inviteId], references: [id], onDelete: Cascade)
  service Service @relation("InviteServiceSubscriptions", fields: [serviceId], references: [id], onDelete: NoAction)

  @@unique([inviteId, serviceId])
  @@map("invite_subscriptions")
}

enum InviteRevokedReason {
  ADMIN
  AUTO_FAILED_ATTEMPTS
  AUTO_SUPERSEDED
}

enum UserStatus {
  PENDING
  ACTIVE
  DELETED
  DISABLED
}

enum OAuthProviderName {
  google
}

enum AuthSchemeName {
  ldap
  oauth
  sso
}

enum LogLevel {
  verbose
  debug
  log
  warn
  error
  fatal
}

enum SubscriptionStatus {
  provisioning
  active
  failed
  cancelling
  cancelled
  expired
  disabling
  disabled
  enabling
}

enum AccountType {
  MANAGED
  REFERENCED
  NONE
}

enum IntegrationProvider {
  jellyfin
  immich
}

enum FailedOperation {
  provisioning
  cancellation
  expiration
  sync
}

enum PolicyEffect {
  ALLOW
  DENY
}

model UserServicePolicy {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  serviceId       Int          @map("service_id")
  effect          PolicyEffect
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User    @relation("UserServicePolicies", fields: [userId], references: [id], onDelete: Cascade)
  service   Service @relation("ServicePolicies", fields: [serviceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("CreatedPolicies", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, serviceId])
  @@map("user_service_policies")
}

model SystemMetadata {
  key       String   @id @db.VarChar(128)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_metadata")
}

model TaskRun {
  id           String    @id @default(uuid()) @db.Uuid
  taskName     String    @map("task_name") @db.VarChar(128)
  startedAt    DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime  @map("finished_at") @db.Timestamptz(6)
  success      Boolean
  errorMessage String?   @map("error_message") @db.Text

  @@index([taskName, startedAt])
  @@map("task_runs")
}