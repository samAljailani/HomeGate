model User {
  id              String              @id @default(uuid())
  email           String              @unique @db.VarChar(254)
  password        String?             @db.VarChar(64)
  firstName       String              @map("first_name") @db.VarChar(100)
  lastName        String              @map("last_name") @db.VarChar(100)
  isAdmin         Boolean             @default(false) @map("is_admin")
  isDeleted       Boolean             @default(false) @map("is_deleted")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  username        String              @db.VarChar(64)
  userSessions    Session[]           @relation("UserSessions")
  userAccounts    UserAccount[]       @relation("UserAccounts")
  oauthIdentities UserOAuthIdentity[] @relation("UserOAuthIdentities")

  @@map("users")
}

model OAuthProvider {
  id              Int                 @id @default(autoincrement())
  name            OAuthProviderName   @unique
  oauthIdentities UserOAuthIdentity[] @relation("ProviderIdentities")

  @@map("oauth_providers")
}

model UserOAuthIdentity {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  profileId  String        @map("profile_id") @db.VarChar(255)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  providerId Int           @map("provider_id")
  provider   OAuthProvider @relation("ProviderIdentities", fields: [providerId], references: [id], onDelete: NoAction)
  user       User          @relation("UserOAuthIdentities", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, profileId], map: "user_oauth_identities_provider_id_profile_id_key")
  @@map("user_oauth_identities")
}

model AuthScheme {
  id       Int            @id @default(autoincrement())
  name     AuthSchemeName @unique
  services Service[]      @relation("ServiceAuthScheme")

  @@map("auth_schemes")
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(64)
  authSchemeId Int           @map("auth_scheme_id")
  authScheme   AuthScheme    @relation("ServiceAuthScheme", fields: [authSchemeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userAccounts UserAccount[] @relation("ServiceAccounts")

  @@map("services")
}

model UserAccount {
  userId    String   @map("user_id")
  serviceId Int      @map("service_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  isActive  Boolean  @default(true) @map("is_active")
  username  String   @db.VarChar(64)
  service   Service  @relation("ServiceAccounts", fields: [serviceId], references: [id], onDelete: NoAction)
  user      User     @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId], map: "user_accounts_pkey")
  @@map("user_accounts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  sid       String   @unique
  data      Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sessions")
}

enum OAuthProviderName {
  google
}

enum AuthSchemeName {
  ldap
  oauth
  sso
}
