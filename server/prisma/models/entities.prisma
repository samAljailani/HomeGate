model User {
  id              String              @id @default(uuid()) @db.Uuid
  email           String              @unique @db.VarChar(254)
  firstName       String              @map("first_name") @db.VarChar(100)
  lastName        String              @map("last_name") @db.VarChar(100)
  isAdmin         Boolean             @default(false) @map("is_admin")
  isDeleted       Boolean             @default(false) @map("is_deleted")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  username        String              @unique @db.VarChar(64)
  userSessions    Session[]           @relation("UserSessions")
  userAccounts    UserAccount[]       @relation("UserAccounts")
  oauthIdentities UserOAuthIdentity[] @relation("UserOAuthIdentities")
  logs            Log[]               @relation("UserLogs")
  createdInvites  Invite[]            @relation("CreatedInvites")
  usedInvite      Invite?             @relation("UsedInvites")

  @@map("users")
}

model OAuthProvider {
  id              Int                 @id @default(autoincrement())
  name            OAuthProviderName   @unique
  enabled         Boolean             @default(false)
  oauthIdentities UserOAuthIdentity[] @relation("ProviderIdentities")

  @@map("oauth_providers")
}

model UserOAuthIdentity {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  profileId  String        @map("profile_id") @db.VarChar(255)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  providerId Int           @map("provider_id")
  provider   OAuthProvider @relation("ProviderIdentities", fields: [providerId], references: [id], onDelete: NoAction)
  user       User          @relation("UserOAuthIdentities", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, profileId], map: "user_oauth_identities_provider_id_profile_id_key")
  @@map("user_oauth_identities")
}

model AuthScheme {
  id       Int            @id @default(autoincrement())
  name     AuthSchemeName @unique

  @@map("auth_schemes")
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(64)
  enabled      Boolean
  userAccounts UserAccount[] @relation("ServiceAccounts")

  @@map("services")
}

model UserAccount {
  userId               String            @map("user_id") @db.Uuid
  serviceId            Int               @map("service_id")
  userServiceAccountId String?           @map("user_service_account_id")
  username             String            @db.VarChar(64)

  status               UserAccountStatus @default(provisioning)

  expiresAt            DateTime?         @map("expires_at") @db.Timestamptz(6)
  autoRenew            Boolean           @map("auto_renew") @default(false)

  provisionedAt        DateTime?         @map("provisioned_at") @db.Timestamptz(6)
  failedAt             DateTime?         @map("failed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  failedOperation      FailedOperation?  @map("failed_operation")
  lastError            String?           @map("last_error") @db.Text
  retryCount           Int               @default(0) @map("retry_count")

  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  service              Service           @relation("ServiceAccounts", fields: [serviceId], references: [id], onDelete: NoAction)
  user                 User              @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId], map: "user_accounts_pkey")
  @@unique([serviceId, username])
  @@unique([serviceId, userServiceAccountId])
  @@map("user_accounts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  sid       String   @unique
  data      Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  logs      Log[]    @relation("SessionLogs")

  @@map("sessions")
}

model Log {
  id            Int       @id @default(autoincrement())
  userId        String?   @map("user_id") @db.Uuid
  sessionId     String?   @map("session_id") @db.Uuid
  correlationId String?   @map("correlation_id")
  logLevel      LogLevel  @map("log_level")
  context       String?   @db.Text
  message       String    @db.Text
  stackTrace    String?   @map("stack_trace")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6) @default(now())
  user          User?     @relation("UserLogs", fields: [userId], references: [id], onDelete: NoAction)
  session       Session?  @relation("SessionLogs", fields: [sessionId], references: [id], onDelete: NoAction)

  @@index([createdAt])
  @@index([logLevel])
  @@index([userId])
  @@index([sessionId])
  @@index([correlationId])

  @@map("logs")
}

model Invite {
  id              String    @id @default(uuid()) @db.Uuid
  token           String    @unique @db.Char(64)
  email           String?   @db.VarChar(254)
  //role  TODO: add this property after adding authorization to the code base.

  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  usedByUserId    String?   @map("used_by_user_id") @db.Uuid

  createdBy       User?     @relation("CreatedInvites", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usedBy          User?     @relation("UsedInvites", fields: [usedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([usedByUserId])
  @@map("invites")
}
enum OAuthProviderName {
  google
}

enum AuthSchemeName {
  ldap
  oauth
  sso
}

enum LogLevel {
  verbose
  debug
  log
  warn
  error
  fatal
}

enum UserAccountStatus {
  provisioning
  active
  failed
  cancelling
  cancelled
  expired
  disabling
  disabled
  enabling
}

enum FailedOperation {
  provisioning
  cancellation
  expiration
  sync
}