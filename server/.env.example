# Application Environment
APP_ENV=development

# Server Configuration
PORT=3003
SERVER_BASE_URL=http://localhost:3003

# Client Static Files
CLIENT_RELATIVE_STATIC_PATH=../client/out/

# Session Configuration
SESSION_SECRET=your-secret-key-min-32-characters-long
SESSION_COOKIE_NAME=HOMEGATE_SID

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:password@localhost:5432/HomeGate
