{
  "name": "homepage",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "server",
    "packages/types",
    "client"
  ],
  "scripts": {
    "build:types": "npm --workspace packages/types run build",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "build": "npm run build:types && npm run build:client && npm run build:server",
    "build:watch": "tsc -b --watch",
    "build:clean": "tsc -b --clean",
    "start:dev:client": "npm --workspace client run dev",
    "start:dev:server": "npm --workspace server run start:dev",
    "start:prod:server": "npm --workspace client run build && npm --workspace server run start:prod"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "yaml": "^2.8.4",
    "sharp": ">=0.35.0",
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    }
  }
}
